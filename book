<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive Visual Book</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Georgia', serif;
        }
        
        body {
            background: linear-gradient(135deg, #6a5acd, #4b0082);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .book-container {
            perspective: 1500px;
            width: 90%;
            max-width: 1000px;
        }
        
        .book {
            position: relative;
            width: 100%;
            height: 600px;
            transform-style: preserve-3d;
            transition: transform 1s;
        }
        
        .book-cover {
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, #8b4513, #a0522d);
            border-radius: 10px 20px 20px 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #f5deb3;
            cursor: pointer;
            backface-visibility: hidden;
            transform-origin: left center;
            transition: transform 1.5s;
            z-index: 10;
        }
        
        .book-cover h1 {
            font-size: 3rem;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            margin-bottom: 20px;
            text-align: center;
        }
        
        .book-cover p {
            font-size: 1.2rem;
            font-style: italic;
            text-align: center;
            max-width: 80%;
        }
        
        .book-cover .open-btn {
            margin-top: 30px;
            padding: 12px 25px;
            background: #f5deb3;
            color: #8b4513;
            border: none;
            border-radius: 5px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .book-cover .open-btn:hover {
            background: #e6c9a1;
            transform: scale(1.05);
        }
        
        .pages-container {
            position: absolute;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 1s;
        }
        
        .page {
            position: absolute;
            width: 100%;
            height: 100%;
            background: #f9f3e9;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            border-radius: 0 10px 10px 0;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            backface-visibility: hidden;
            transform-origin: left center;
            transition: transform 1s;
        }
        
        .page-content {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        .page-title {
            font-size: 2.2rem;
            color: #8b4513;
            margin-bottom: 30px;
            text-align: center;
        }
        
        .portrait-container {
            width: 300px;
            height: 400px;
            border: 3px solid #8b4513;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 30px;
            background: #fff;
            overflow: hidden;
            position: relative;
        }
        
        .portrait-image {
            max-width: 100%;
            max-height: 100%;
            display: none;
        }
        
        .portrait-placeholder {
            text-align: center;
            color: #a9a9a9;
            padding: 20px;
        }
        
        .upload-btn {
            padding: 10px 20px;
            background: #8b4513;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.3s;
        }
        
        .upload-btn:hover {
            background: #6b3300;
            transform: scale(1.05);
        }
        
        .file-input {
            display: none;
        }
        
        .navigation {
            position: absolute;
            bottom: 20px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 40px;
        }
        
        .nav-btn {
            padding: 10px 20px;
            background: #8b4513;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.3s;
        }
        
        .nav-btn:hover {
            background: #6b3300;
        }
        
        .nav-btn:disabled {
            background: #cccccc;
            cursor: not-allowed;
        }
        
        .page-number {
            position: absolute;
            bottom: 25px;
            font-size: 1.1rem;
            color: #8b4513;
        }
        
        /* Book open state */
        .book.open .book-cover {
            transform: rotateY(-180deg);
        }
        
        /* Page turning animations */
        .page.turned {
            transform: rotateY(-180deg);
        }
        
        .page.active {
            z-index: 5;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .book {
                height: 500px;
            }
            
            .book-cover h1 {
                font-size: 2.2rem;
            }
            
            .portrait-container {
                width: 250px;
                height: 350px;
            }
        }
        
        @media (max-width: 480px) {
            .book {
                height: 400px;
            }
            
            .book-cover h1 {
                font-size: 1.8rem;
            }
            
            .portrait-container {
                width: 200px;
                height: 280px;
            }
            
            .page-title {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
    <div class="book-container">
        <div class="book">
            <div class="book-cover">
                <h1>My Visual Diary</h1>
                <p>A collection of memories and moments</p>
                <button class="open-btn">Open Book</button>
            </div>
            
            <div class="pages-container">
                <!-- Page 1 -->
                <div class="page active" id="page1">
                    <div class="page-content">
                        <h2 class="page-title">Family Moments</h2>
                        <div class="portrait-container">
                            <div class="portrait-placeholder">
                                <p>Add a family photo</p>
                                <p>Click "Upload Image" below</p>
                            </div>
                            <img class="portrait-image" id="image1" src="" alt="Portrait">
                        </div>
                        <input type="file" class="file-input" id="fileInput1" accept="image/*">
                        <button class="upload-btn" data-page="1">Upload Image</button>
                    </div>
                    <div class="navigation">
                        <button class="nav-btn prev-btn" disabled>Previous</button>
                        <button class="nav-btn next-btn">Next</button>
                    </div>
                    <div class="page-number">Page 1</div>
                </div>
                
                <!-- Page 2 -->
                <div class="page" id="page2">
                    <div class="page-content">
                        <h2 class="page-title">Travel Adventures</h2>
                        <div class="portrait-container">
                            <div class="portrait-placeholder">
                                <p>Add a travel photo</p>
                                <p>Click "Upload Image" below</p>
                            </div>
                            <img class="portrait-image" id="image2" src="" alt="Portrait">
                        </div>
                        <input type="file" class="file-input" id="fileInput2" accept="image/*">
                        <button class="upload-btn" data-page="2">Upload Image</button>
                    </div>
                    <div class="navigation">
                        <button class="nav-btn prev-btn">Previous</button>
                        <button class="nav-btn next-btn">Next</button>
                    </div>
                    <div class="page-number">Page 2</div>
                </div>
                
                <!-- Page 3 -->
                <div class="page" id="page3">
                    <div class="page-content">
                        <h2 class="page-title">Special Occasions</h2>
                        <div class="portrait-container">
                            <div class="portrait-placeholder">
                                <p>Add a special occasion photo</p>
                                <p>Click "Upload Image" below</p>
                            </div>
                            <img class="portrait-image" id="image3" src="" alt="Portrait">
                        </div>
                        <input type="file" class="file-input" id="fileInput3" accept="image/*">
                        <button class="upload-btn" data-page="3">Upload Image</button>
                    </div>
                    <div class="navigation">
                        <button class="nav-btn prev-btn">Previous</button>
                        <button class="nav-btn next-btn">Next</button>
                    </div>
                    <div class="page-number">Page 3</div>
                </div>
                
                <!-- Page 4 -->
                <div class="page" id="page4">
                    <div class="page-content">
                        <h2 class="page-title">Future Dreams</h2>
                        <div class="portrait-container">
                            <div class="portrait-placeholder">
                                <p>Add a photo representing your dreams</p>
                                <p>Click "Upload Image" below</p>
                            </div>
                            <img class="portrait-image" id="image4" src="" alt="Portrait">
                        </div>
                        <input type="file" class="file-input" id="fileInput4" accept="image/*">
                        <button class="upload-btn" data-page="4">Upload Image</button>
                    </div>
                    <div class="navigation">
                        <button class="nav-btn prev-btn">Previous</button>
                        <button class="nav-btn next-btn" disabled>Next</button>
                    </div>
                    <div class="page-number">Page 4</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const book = document.querySelector('.book');
            const openBtn = document.querySelector('.open-btn');
            const pages = document.querySelectorAll('.page');
            const prevBtns = document.querySelectorAll('.prev-btn');
            const nextBtns = document.querySelectorAll('.next-btn');
            const uploadBtns = document.querySelectorAll('.upload-btn');
            const fileInputs = document.querySelectorAll('.file-input');
            
            let currentPage = 0;
            const totalPages = pages.length;
            
            // Open book
            openBtn.addEventListener('click', function() {
                book.classList.add('open');
            });
            
            // Next page
            nextBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (currentPage < totalPages - 1) {
                        pages[currentPage].classList.add('turned');
                        currentPage++;
                        updateNavigation();
                    }
                });
            });
            
            // Previous page
            prevBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    if (currentPage > 0) {
                        currentPage--;
                        pages[currentPage].classList.remove('turned');
                        updateNavigation();
                    }
                });
            });
            
            // Update navigation buttons
            function updateNavigation() {
                // Update previous buttons
                prevBtns.forEach(btn => {
                    btn.disabled = currentPage === 0;
                });
                
                // Update next buttons
                nextBtns.forEach(btn => {
                    btn.disabled = currentPage === totalPages - 1;
                });
            }
            
            // Image upload functionality
            uploadBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const pageNum = this.getAttribute('data-page');
                    const fileInput = document.getElementById(`fileInput${pageNum}`);
                    fileInput.click();
                });
            });
            
            fileInputs.forEach(input => {
                input.addEventListener('change', function() {
                    const pageNum = this.id.replace('fileInput', '');
                    const file = this.files[0];
                    
                    if (file) {
                        const reader = new FileReader();
                        
                        reader.onload = function(e) {
                            const image = document.getElementById(`image${pageNum}`);
                            const placeholder = image.parentElement.querySelector('.portrait-placeholder');
                            
                            image.src = e.target.result;
                            image.style.display = 'block';
                            placeholder.style.display = 'none';
                        };
                        
                        reader.readAsDataURL(file);
                    }
                });
            });
        });
    </script>
</body>
</html>
